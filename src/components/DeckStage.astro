---
const { slides = [] } = Astro.props;
---

<deck-stage class="deck-stage" tabindex="0" aria-label="Weekly presentation slides">
  {slides.map((slide, index) => (
    <section class:list={['deck-slide', slide.layout === 'cover' && 'deck-slide--cover']} data-slide={index}>
      <div class="deck-slide__number">{String(index + 1).padStart(2, '0')}</div>
      <article class="deck-slide__content">
        {slide.title && <h2 class="deck-slide__title">{slide.title}</h2>}
        <div class="deck-slide__body" set:html={slide.html} />
      </article>
      <button class="deck-slide__next" type="button" aria-label="Next slide">Next</button>
    </section>
  ))}
</deck-stage>

<script is:inline>
  const stage = document.querySelector('deck-stage');
  if (stage) {
    const slides = [...stage.querySelectorAll('.deck-slide')];
    let active = 0;

    const show = (index) => {
      active = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));
    };

    stage.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.closest('a, button')) return;
      show(active + 1);
    });

    stage.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'PageDown' || event.key === ' ') {
        event.preventDefault();
        show(active + 1);
      }
      if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
        event.preventDefault();
        show(active - 1);
      }
    });

    slides.forEach((slide, index) => {
      slide.querySelector('.deck-slide__next')?.addEventListener('click', (event) => {
        event.stopPropagation();
        show(index + 1);
      });
    });

    show(0);
  }
</script>
