---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Future Work" description="Planned next steps and future directions.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Future Work</h1>
    <p class="max-w-3xl text-slate-300">Use this page to record planned work for the coming weeks and longer-term thesis goals.</p>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">Next week</h2>
      <ul class="list-disc space-y-2 pl-5 text-slate-300">
        <li>Getting settled with a class routine</li>
        <li>Continue literature search</li>
        <li>Narrow down agentic AI project scope to support the thesis goal</li>
      </ul>
    </div>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">Notes for the presentation deck</h2>
      <p class="text-slate-300">This content is pulled into the weekly presentation slide that corresponds to Future Work.</p>
    </div>
  </section>
</BaseLayout>
