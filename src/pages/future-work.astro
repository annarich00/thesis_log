---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Future Work" description="Planned next steps and future directions.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Future Work</h1>
    <p class="max-w-3xl text-slate-300">Use this page to record planned work for the coming weeks and longer-term thesis goals.</p>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">Upcoming tasks</h2>
      <ul class="list-disc space-y-2 pl-5 text-slate-300">
        <li>Refine the presentation structure.</li>
        <li>Expand the literature search with more relevant papers.</li>
        <li>Write next week&apos;s work summary.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
