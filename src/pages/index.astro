---
import BaseLayout from '../layouts/BaseLayout.astro';
import PresentationDeck from '../components/PresentationDeck.astro';
---

<BaseLayout title="Weekly Presentations" description="Weekly presentation deck for advisor meetings.">
  <script src="/thesis_log/deck-stage.js"></script>
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Thesis Log</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Weekly Section</h1>
    </div>
    <PresentationDeck />
  </section>
</BaseLayout>
