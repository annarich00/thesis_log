---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="Weekly Presentations" description="Weekly presentation hub for advisor meetings.">
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Thesis Log</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Weekly Presentations</h1>
      <p class="max-w-3xl text-lg text-slate-300">
        This site organizes weekly advisor presentations, literature search notes, weekly work updates, and future plans.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <article class="card space-y-4">
        <h2 class="text-2xl font-semibold">This week&apos;s presentation</h2>
        <p class="text-slate-300">Use this area to summarize what you will present to your advisor each week.</p>
        <div class="flex flex-wrap gap-3">
          <a class="rounded-full bg-sky-300 px-4 py-2 font-semibold text-slate-950" href={resolvePath('/weekly-work')}>View weekly work</a>
          <a class="rounded-full border border-white/15 px-4 py-2 font-semibold text-white" href={resolvePath('/literature-search')}>Open literature search</a>
        </div>
      </article>

      <article class="card space-y-4">
        <h2 class="text-2xl font-semibold">Presentation links</h2>
        <p class="text-slate-300">Add your PowerPoint or Canvas link here for each weekly meeting.</p>
        <div class="space-y-3 text-sm text-slate-200">
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <p class="font-semibold">PowerPoint</p>
            <p class="mt-1 text-slate-400">Paste the weekly slide deck link here.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <p class="font-semibold">Canvas</p>
            <p class="mt-1 text-slate-400">Paste the Canvas presentation or submission link here.</p>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
