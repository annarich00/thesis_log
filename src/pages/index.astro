---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
import DeckStage from '../components/DeckStage.astro';

const slides = [
  {
    title: 'Weekly Presentations',
    html: `<p>This week’s outline follows the three working tabs in the site:</p><ul><li><a href="${resolvePath('/literature-search')}">Literature Search</a></li><li><a href="${resolvePath('/weekly-work')}">Weekly Work</a></li><li><a href="${resolvePath('/future-work')}">Future Work</a></li></ul>`,
  },
  {
    title: 'Weekly work',
    html: `<p><strong>Work over the past week</strong></p><ul><li>Classes started!</li><li>Got started on the agentic AI repo assignment</li><li>Searched for more related papers, but have yet to dig deep into all listed</li></ul><p><a href="${resolvePath('/weekly-work')}">Open the Weekly Work tab</a></p>`,
  },
  {
    title: 'Literature search',
    html: `<p><strong>Class drop proposals</strong></p><ul><li>Zero G class — not as applicable as I had hoped</li></ul><p><strong>Interesting applicable papers</strong></p><ul><li><a href="https://spj.science.org/doi/full/10.34133/space.0271" target="_blank" rel="noreferrer">Space article</a>: Relevant space-research framing for the thesis direction.</li><li><a href="https://arxiv.org/pdf/2606.20394" target="_blank" rel="noreferrer">arXiv preprint</a>: Recent work that may inform the agentic AI project scope.</li><li><a href="https://ieeexplore.ieee.org/abstract/document/11635138" target="_blank" rel="noreferrer">IEEE paper</a>: Potentially applicable engineering AI methods or decision support.</li></ul><p><a href="${resolvePath('/literature-search')}">Open the Literature Search tab</a></p>`,
  },
  {
    title: 'Future work',
    html: `<p><strong>Work over the next week</strong></p><ul><li>Getting settled with a class routine</li><li>Continue literature search</li><li>Narrow down agentic AI project scope to support the thesis goal</li></ul><p><a href="${resolvePath('/future-work')}">Open the Future Work tab</a></p>`,
  },
];
---

<BaseLayout title="Weekly Presentations" description="Weekly presentation deck for advisor meetings.">
  <script src={resolvePath('/deck-stage.js')}></script>
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Thesis Log</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Weekly Presentations</h1>
      <p class="max-w-3xl text-lg text-slate-300">This page is formatted like a slide deck, matching your professor’s integrated site style.</p>
    </div>
    <DeckStage slides={slides} />
  </section>
</BaseLayout>
