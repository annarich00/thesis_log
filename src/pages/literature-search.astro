---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Literature Search" description="Annotated literature search notes and paper tracking.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Literature Search</h1>
    <p class="max-w-3xl text-slate-300">Track papers, notes, and relevance to the thesis topic here.</p>

    <div class="grid gap-6 md:grid-cols-2">
      <article class="card space-y-3">
        <h2 class="text-2xl font-semibold">Paper 1</h2>
        <p class="text-slate-300">Add a title, citation, and summary here.</p>
      </article>
      <article class="card space-y-3">
        <h2 class="text-2xl font-semibold">Paper 2</h2>
        <p class="text-slate-300">Add a title, citation, and summary here.</p>
      </article>
    </div>
  </section>
</BaseLayout>
