---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Weekly Work" description="Weekly work log and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Weekly Work</h1>
    <p class="max-w-3xl text-slate-300">Log what you did each week in detail so it can be reviewed with your advisor.</p>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">This week</h2>
      <ul class="list-disc space-y-2 pl-5 text-slate-300">
        <li>Classes started!</li>
        <li>Got started on the agentic AI repo assignment</li>
        <li>Searched for more related papers, but have yet to dig deep into all listed</li>
      </ul>
    </div>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">Notes for the presentation deck</h2>
      <p class="text-slate-300">This content is pulled into the weekly presentation slide that corresponds to Weekly Work.</p>
    </div>
  </section>
</BaseLayout>
