---
import BaseLayout from '../layouts/BaseLayout.astro';
import { weeklyWork } from '../lib/presentation';
---

<BaseLayout title="Weekly Work" description="Weekly work log and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Weekly Work</h1>
    <p class="max-w-3xl text-slate-300">Log what you did each week in detail so it can be reviewed with your advisor.</p>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">This week</h2>
      <ul class="list-disc space-y-2 pl-5 text-slate-300">
        {weeklyWork.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold">Deck notes</h2>
      <p class="text-slate-300">The Weekly Presentations slide for this topic is built from this page’s content source.</p>
    </div>
  </section>
</BaseLayout>
