---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Weekly Work" description="Weekly work log and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Weekly Work</h1>
    <p class="max-w-3xl text-slate-300">Log what you did each week in detail so it can be reviewed with your advisor.</p>

    <div class="space-y-4">
      <article class="card">
        <h2 class="text-2xl font-semibold">Week entry</h2>
        <p class="mt-3 text-slate-300">Add weekly accomplishments, blockers, and decisions here.</p>
      </article>
    </div>
  </section>
</BaseLayout>
